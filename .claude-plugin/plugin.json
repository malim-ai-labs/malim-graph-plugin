{
  "name": "malimgraph",
  "version": "0.2.0",
  "description": "Agentic knowledge graph plugin for Claude Code",
  "author": {
    "name": "Malim AI Labs"
  },
  "engines": {
    "claudeCode": ">=2.0.0"
  },
  "mcpServers": {
    "malimgraph": {
      "command": "uvx",
      "args": ["malimgraph", "malimgraph-plugin"],
      "description": "Core MalimGraph MCP server for extracting knowledge graphs and building RAG pipelines",
      "optional": false
    }
  },
  "capabilities": {
    "commands": [
      {
        "name": "kg",
        "description": "Initialize MalimGraph Knowledge Graph Orchestration",
        "path": ".claude/commands/kg.md"
      }
    ]
  }
}
